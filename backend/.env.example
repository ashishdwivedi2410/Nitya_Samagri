# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database — MongoDB (was PostgreSQL/DATABASE_URL)
MONGO_URI=mongodb://nityasamagri:password@localhost:27017/nityasamagri?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Twilio — no longer used for OTP/login (that's Firebase now, see below),
# but still used by src/integrations/twilio.ts for order-status SMS
# notifications (shipped/delivered updates etc). Read directly from
# process.env in twilio.ts, not through config/env.ts.
TWILIO_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_TOKEN=your_auth_token
TWILIO_PHONE=+1XXXXXXXXXX

# Firebase (used for phone OTP auth — Firebase handles sending the SMS
# client-side; the backend only verifies the ID token it gets back, via
# Firebase Admin SDK verifyIdToken()). Also usable for push notifications.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Email — Nodemailer over Gmail/Google Workspace SMTP (uses the Firebase
# project's Google account; not Firebase's own API — Firebase doesn't have
# a transactional email API). Use a Google Workspace address or a Gmail
# account with an App Password (not your normal password — generate one at
# https://myaccount.google.com/apppasswords, requires 2FA enabled).
GMAIL_USER=noreply@nityasamagri.in
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Eshopbox (replaces Shiprocket) — static Bearer API token generated in
# your Eshopbox workspace settings (not an OAuth client_id/secret flow).
ESHOPBOX_API_TOKEN=your_eshopbox_bearer_token
# The "sales channel" identifier Eshopbox assigns your integration —
# sent as externalChannelID on every order create call.
ESHOPBOX_EXTERNAL_CHANNEL_ID=your_channel_id
# Required to accept POST /integrations/shipping/webhook — generate a long
# random value and configure it in your Eshopbox workspace's webhook
# settings. Verify the exact field names against a real webhook payload.
ESHOPBOX_WEBHOOK_SECRET=

# AWS S3 (media uploads)
AWS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nityasamagri-media

# WhatsApp Business API
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_number_id

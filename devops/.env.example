# ─────────────────────────────────────────────────────────────────────────────
# .env.example — devops/infra-level config. Copy to .env and fill in.
# This is DIFFERENT from backend/.env.example — that one is app config
# (DB, JWT, Razorpay...); this one is what the deploy scripts/CI need.
# ─────────────────────────────────────────────────────────────────────────────

# Deploy target
SERVER_HOST=
SERVER_USER=ubuntu
SERVER_SSH_KEY=          # paste as a GitHub Actions secret, not here

# Docker Hub
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# MongoDB (used by docker-compose + backup.sh)
MONGO_ROOT_USER=nityasamagri
MONGO_ROOT_PASSWORD=

# Redis — used both as the docker-compose REDIS_PASSWORD env var and as
# --requirepass at runtime when redis/redis.conf is mounted in
# (requirepass isn't hardcoded in redis.conf on purpose, see that file)
REDIS_PASSWORD=

# S3 backups (scripts/backup.sh)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Chatbot service (NEW — see nitya-samagri-chatbot)
AI_API_KEY=

# Monitoring
GRAFANA_ADMIN_PASSWORD=

# Terraform
TF_VAR_key_pair_name=
